// SPDX-License-Identifier: (GPL-2.0-or-later OR BSD-2-Clause)
/*
 * WD My Cloud Home Duo device tree
 * Based on Realtek RTD1296 SoC ("Pelican" board, vendor codename)
 *
 * Ported from kernel 4.9.330 (vendor symops/pelican-4.9.330) to 6.18,
 * following the same approach already proven on the single-bay WD My
 * Cloud Home (RTD1295 "Monarch", see rtd1295-wd-mycloud-home.dts in this
 * same directory -- that file's history/comments explain most of the
 * generic RTD129x-family bring-up decisions this file inherits unchanged
 * (SMP spin-table, IRQ mux, PWM/LED, cpufreq, thermal, GMAC, USB dwc3).
 *
 * RTD1296 is the same silicon as RTD1295 with a second SATA lane and a
 * third (u3host) USB controller bonded out -- see the vendor's
 * rtd-1296-saola-common.dtsi vs. rtd-1295-giraffe-common.dtsi (nearly
 * identical) and rtd-1296.dtsi vs. rtd-1295.dtsi (adds rtd-1296-sata.dtsi
 * with a second sata-phy/sata-port, and rtd-1296-usb.dtsi with a
 * dwc3_u3host block + an RTS5400 Type-C PD companion chip on i2c_5,
 * investigated and closed -- see the Progress log in README.md).
 * The WD My Cloud Home Duo boots its OS from eMMC (bootargs androidboot.storage=emmc in
 * the vendor DTS) and uses its two SATA bays for user data (RAID), unlike
 * the single-bay Monarch which boots from SATA directly. This port keeps
 * running rootfs from SATA (see the USB-rescue dev loop below) rather than
 * matching the vendor's eMMC-OS/SATA-data split, but the eMMC controller
 * itself is now ported (drivers/mmc/host/dw_mmc-rtd129x.c, see the `emmc`
 * node further down) as a plain mountable block device -- no mainline
 * RTD129x eMMC driver existed upstream; this one is new, a thin glue on
 * top of the mainline dw_mmc core (the IP is a genuine DesignWare Mobile
 * Storage Host, register-compatible, once you look past the vendor's own
 * from-scratch driver).
 *
 * Dual-SATA register values (CRT reset bits, PHY calibration tables) in
 * this file and in drivers/ata/ahci_rtd1295.c are cross-checked against
 * BOTH the vendor pelican-4.9.330 board DTS (rtd-1296-pelican-1GB.dts)
 * and a real vendor 4.9.330 boot log from an actual WD My Cloud Home Duo
 * unit with two WDC WD5000AZLX drives installed (both bays linking at
 * 6.0 Gbps) -- see the comment above ahci_rtd1295_ports_1296[] in that
 * driver for the exact register traces.
 */

/dts-v1/;

/*
 * Same USB-rescue-loader ramdisk staging convention as Monarch: see the
 * matching comment in rtd1295-wd-mycloud-home.dts. Confirmed identical on
 * this SoC family -- the vendor rtd-1296-pelican-rescue.dts reserves the
 * same ROOTFS_RESCUE_START/SIZE (0x02200000/0x00C00000) from
 * include/soc/realtek/memory.h, and the FDT "reserving fdt memory region:
 * addr=2200000 size=400000" line in the real Duo boot log matches exactly.
 */
/memreserve/ 0x02200000 0x00C00000;

#include "rtd1296.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/reset/realtek,rtd1295.h>

/ {
	compatible = "wd,mycloud-home-duo", "realtek,rtd1296";
	model = "WD My Cloud Home Duo";

	/*
	 * Confirmed by the real boot log ("U-Boot 2015.07 ... DRAM: 1 GiB").
	 * Same 32-bit root address cells caveat as Monarch: fine as long as
	 * everything stays below 4 GiB.
	 */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x40000000>;
	};

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x98007800 console=ttyS0,115200 panic=5";
		stdout-path = "serial0:115200n8";
		linux,initrd-start = <0x02200000>;
		linux,initrd-end = <0x02600000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x02000000>;
			linux,cma-default;
		};

		ramoops@22000000 {
			compatible = "ramoops";
			reg = <0x22000000 0x200000>;
			record-size = <0x4000>;
			console-size = <0x100000>;
			ftrace-size = <0x4000>;
		};
	};
};

&rbus {
	/* Same RTD129x interrupt mux as Monarch -- see that file's comment. */
	mux_intc: interrupt-controller@1b000 {
		compatible = "Realtek,rtk-irq-mux";
		status = "okay";
		interrupt-controller;
		#interrupt-cells = <2>;

		Realtek,mux-nr = <2>;
		intr-status = <0x0c 0x00>;
		intr-en = <0x80 0x40>;

		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;

		reg = <0x1b000 0x100>, <0x7000 0x100>;
	};

	/*
	 * I2C buses, same "realtek,rtk-i2c" binding and RBUS addresses as
	 * Monarch (SoC-level, not board-specific). i2c5 additionally carries
	 * an RTS5400 Type-C PD companion chip on this board (vendor
	 * rtd1296.dtsi &i2c_5) -- investigated and closed, not planned: its
	 * USB3 hub function is transparent hardware needing no driver at
	 * all, and the vendor I2C driver only ever gates one optional 12V
	 * accessory-power GPIO after a proprietary PD negotiation. Left
	 * unlisted here. See README.md's Progress log.
	 */
	i2c0: i2c@7d00 {
		compatible = "realtek,rtk-i2c";
		reg = <0x7d00 0x100>, <0x7000 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <1 8>;
		i2c-num = <0>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		pmic@12 {
			compatible = "gmt,g2227";
			reg = <0x12>;
			status = "okay";

			regulators {
				compatible = "gmt,g2227-regulator";
				status = "okay";

				dc1 { regulator-boot-on; regulator-always-on; regulator-name = "vd33"; regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3300000>; regulator-initial-mode = <1>; };
				dc2 { regulator-boot-on; regulator-always-on; regulator-name = "cpudvs"; regulator-min-microvolt = <800000>; regulator-max-microvolt = <1187500>; regulator-initial-mode = <0>; regulator-state-mem { regulator-off-in-suspend; }; };
				dc3 { regulator-boot-on; regulator-always-on; regulator-name = "gpudvs"; regulator-min-microvolt = <800000>; regulator-max-microvolt = <1187500>; regulator-initial-mode = <0>; regulator-ramp-delay = <625>; regulator-state-mem { regulator-off-in-suspend; }; };
				dc4 { regulator-boot-on; regulator-always-on; regulator-name = "ddr"; regulator-min-microvolt = <1500000>; regulator-max-microvolt = <1500000>; regulator-initial-mode = <0>; regulator-state-coldboot { regulator-off-in-suspend; }; };
				dc5 { regulator-boot-on; regulator-always-on; regulator-name = "iso"; regulator-min-microvolt = <800000>; regulator-max-microvolt = <1187500>; regulator-initial-mode = <0>; };
				dc6 { regulator-boot-on; regulator-always-on; regulator-name = "top"; regulator-min-microvolt = <800000>; regulator-max-microvolt = <1187500>; regulator-initial-mode = <0>; regulator-state-mem { regulator-off-in-suspend; }; };
				ldo2 { regulator-boot-on; regulator-always-on; regulator-name = "ldo2"; regulator-min-microvolt = <1500000>; regulator-max-microvolt = <1900000>; regulator-initial-mode = <0>; regulator-state-mem { regulator-off-in-suspend; }; };
				ldo3 { regulator-boot-on; regulator-always-on; regulator-name = "ldo3"; regulator-min-microvolt = <800000>; regulator-max-microvolt = <1200000>; regulator-initial-mode = <0>; regulator-state-mem { regulator-off-in-suspend; }; };
			};
		};
	};

	i2c1: i2c@7c00 {
		compatible = "realtek,rtk-i2c";
		reg = <0x7c00 0x100>, <0x7000 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <1 11>;
		i2c-num = <1>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c2: i2c@1b700 {
		compatible = "realtek,rtk-i2c";
		reg = <0x1b700 0x100>, <0x1b00c 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <0 26>;
		i2c-num = <2>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c3: i2c@1b900 {
		compatible = "realtek,rtk-i2c";
		reg = <0x1b900 0x100>, <0x1b00c 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <0 23>;
		i2c-num = <3>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c4: i2c@1ba00 {
		compatible = "realtek,rtk-i2c";
		reg = <0x1ba00 0x100>, <0x1b00c 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <0 15>;
		i2c-num = <4>;
		status = "disabled";
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c5: i2c@1bb00 {
		compatible = "realtek,rtk-i2c";
		reg = <0x1bb00 0x100>, <0x1b00c 0x100>;
		interrupt-parent = <&mux_intc>;
		interrupts = <0 14>;
		i2c-num = <5>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
	};

	/*
	 * ISO_GPIO block -- mainline drivers/gpio/gpio-rtd.c
	 * ("realtek,rtd1295-iso-gpio"), never previously instantiated
	 * anywhere in this port (neither here nor in Monarch's DTS -- both
	 * only carried a stale "TODO: Port GPIO and pinctrl" comment). Added
	 * now specifically to expose the Reset button (see below); nothing
	 * else on this board needs it yet.
	 *
	 * `reg` order is [0]=GPIO data/control registers, [1]=GPIO interrupt
	 * (assert/deassert status) registers -- confirmed against the
	 * driver's own upstream binding
	 * (Documentation/devicetree/bindings/gpio/realtek,rtd-gpio.yaml
	 * example: "reg: [0] GPIO controller registers, [1] GPIO interrupt
	 * registers") and cross-checked against this file's own
	 * already-hardware-confirmed RTD_MISC_GPIO_DIR/DATO offsets in
	 * ahci_rtd1295.c (dir=+0x0, dato=+0x10 relative to 0x9801b100, the
	 * *second* of the vendor DTS's two misc_gpio reg entries) -- i.e.
	 * this order is the reverse of how the vendor's own (differently
	 * structured) DTS lists the same two physical blocks. ISO_GPIO is
	 * 0x98007100 (rbus-relative 0x7100) / ISO_SYS is 0x98007000
	 * (rbus-relative 0x7000), same pairing as the vendor's own
	 * rtk_iso_gpio@98007100 node in rtd-1296.dtsi.
	 *
	 * interrupts: same &mux_intc bank/bit pair as the vendor's own
	 * rtk_iso_gpio node (interrupt-parent = <&mux_intc>; interrupts =
	 * <1 19>, <1 20>; in rtd-1296.dtsi) -- GPIOA_INT (assert) then
	 * GPIODA_INT (deassert), mux bank 1 (same bank i2c0/i2c1 above use).
	 *
	 * No pinctrl driver exists in this port yet (same stale TODO as
	 * above), so gpio-ranges -- required by the binding -- is omitted;
	 * these 35 ISO GPIO lines default to GPIO mode with no pinmux group
	 * needed (same reasoning already applied to the LED GPIOs in
	 * ahci_rtd1295.c/rtd1295-wd-mycloud-home.dts's pwm-leds). This is a
	 * schema violation `make dtbs_check` would flag, not something
	 * `make dtbs` itself checks.
	 *
	 * reg[1] (the ISO_SYS/interrupt-status block) is intentionally only
	 * 0x10 bytes, not the vendor's full 0x100-byte page: that page is
	 * shared with other, already-working peripherals at unrelated byte
	 * offsets within it -- &pwm at +0xd0 (rtd129x-pwm, this board's SYS
	 * LED and fan) and a simple-reset controller at +0x88 -- and
	 * devm_platform_ioremap_resource() reserves a reg entry's *entire*
	 * declared size exclusively via request_mem_region(), regardless of
	 * which bytes gpio-rtd.c actually touches. Declaring the vendor's
	 * full 0x100 here claimed that whole page and broke both of those
	 * drivers with "-EBUSY: can't request region" on real hardware
	 * (confirmed: SYS LED and fan both stopped working). 0x10 bytes
	 * covers only the registers gpio-rtd.c's rtd1295_iso_gpio_info
	 * actually needs for GPIO 22 (gpa_offset[0]=0x8, gpda_offset[0]=0xc
	 * -- the first status bank, GPIOs 0-30): far short of +0x88/+0xd0,
	 * so no more overlap. A future consumer needing local GPIO >=30 on
	 * this chip (bank 1, gpa/gpda at +0xe0/+0xe4) would need a wider
	 * window and would have to solve this same page-sharing conflict
	 * again; out of scope for this button.
	 */
	rtk_iso_gpio: gpio@7100 {
		compatible = "realtek,rtd1295-iso-gpio";
		reg = <0x7100 0x100>, <0x7000 0x10>;
		interrupt-parent = <&mux_intc>;
		interrupts = <1 19>, <1 20>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};

	/*
	 * Cosmetic power-off -- see drivers/power/reset/wdmc-poweroff.c for
	 * the full story on why this isn't a real power cut. reg[0] is the
	 * pwm@d0 block's own OCD register (4 bytes, all 4 channels packed
	 * into one word -- see that node's own comment on why this can't be
	 * an exclusive devm_platform_ioremap_resource() claim).
	 *
	 * wd,usb-vbus-gpios: misc-gpio (raw MMIO, 0x9801b100/0x9801b110) was
	 * the first thing tried here and was exhaustively disproven on real
	 * hardware -- every one of its 64 bits (both banks) swept with zero
	 * effect on VBUS. These two rtk_iso_gpio lines are what the vendor's
	 * own stock-firmware boot log on this exact unit actually uses
	 * (rtk_usb_manager: power-gpio id=127/135 -> local offsets 26/34
	 * under rtk_iso_gpio's gpio_base=101), confirmed by direct testing
	 * to each cut one external USB port's power when held low for
	 * several seconds (not a brief pulse) and restore it when driven
	 * back high: line 34 is the bottom bay's port, line 26 the top
	 * one's.
	 */
	poweroff: poweroff@70d0 {
		compatible = "wd,mycloud-home-poweroff";
		reg = <0x70d0 0x4>;
		wd,pwm-off-channels = <0 3>; /* SYS LED=0, fan=3 */
		wd,usb-vbus-gpios = <&rtk_iso_gpio 34 GPIO_ACTIVE_HIGH>,
				     <&rtk_iso_gpio 26 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/*
	 * SATA PHY + AHCI controller, two ports. PHY driver: mainline
	 * drivers/phy/realtek/phy-rtk-sata.c; AHCI glue:
	 * drivers/ata/ahci_rtd1295.c (compatible "realtek,rtd1296-ahci" ->
	 * ahci_rtd1295_ports_1296[], two CRT-reset/gpio entries, see that
	 * driver's comment for the exact register values and how they were
	 * confirmed against a real two-bay boot log).
	 *
	 * phy-param and rx-sense-tbl are identical for both ports (verbatim
	 * from the vendor rtd-1296-pelican-1GB.dts sata_phy@9803FF60 node,
	 * cross-checked byte-for-byte against the real boot log's "phy0
	 * para"/"phy1 para" and "rxsense" trace lines). tx-driving-tbl is the
	 * only per-port difference (0x387a.../0x587a...), also confirmed by
	 * the log's "phy0 txdrv"/"phy1 txdrv" lines.
	 */
	sata_phy: sata-phy@3ff00 {
		compatible = "Realtek,rtk-sata-phy";
		reg = <0x3ff00 0x100>, <0x1a980 0x10>;
		#address-cells = <1>;
		#size-cells = <0>;
		#phy-cells = <1>;
		status = "okay";

		sata-phy@0 {
			reg = <0>;
			spread-spectrum = <0>;

			phy-param = <0x00001111>, <0x00005111>, <0x00009111>,
				    <0x336a0511>, <0x336a4511>, <0x336a8511>,
				    <0xE0700111>, <0xE05C4111>, <0xE04A8111>,
				    <0x00150611>, <0x00154611>, <0x00158611>,
				    <0xC6000A11>, <0xC6004A11>, <0xC6008A11>,
				    <0x70000211>, <0x70004211>, <0x70008211>,
				    <0xC6600A11>, <0xC6604A11>, <0xC6608A11>,
				    <0x20041911>, <0x20045911>, <0x20049911>,
				    <0x94aa2011>, <0x94aa6011>, <0x94aaa011>,
				    <0x17171511>, <0x17175511>, <0x17179511>,
				    <0x07701611>, <0x07705611>, <0x07709611>,
				    <0x00002a11>, <0x00006a11>, <0x0000aa11>,
				    <0x27710311>, <0x27684311>, <0x27648311>,
				    <0x29001011>, <0x29005011>, <0x29009011>,
				    <0xc0000C11>, <0xc0004C11>, <0xc0008C11>,
				    <0x00271711>, <0x00275711>, <0x00279711>;

			tx-driving-tbl = <0x94a72011>, <0x94a76011>, <0x94a7a011>,
					  <0x387a2111>, <0x387a6111>, <0x387aa111>;

			rx-sense-tbl = <0x72100911>, <0x72104911>, <0x72108911>,
					<0x27750311>, <0x276e4311>, <0x276c8311>;
		};

		sata-phy@1 {
			reg = <1>;
			spread-spectrum = <0>;

			phy-param = <0x00001111>, <0x00005111>, <0x00009111>,
				    <0x336a0511>, <0x336a4511>, <0x336a8511>,
				    <0xE0700111>, <0xE05C4111>, <0xE04A8111>,
				    <0x00150611>, <0x00154611>, <0x00158611>,
				    <0xC6000A11>, <0xC6004A11>, <0xC6008A11>,
				    <0x70000211>, <0x70004211>, <0x70008211>,
				    <0xC6600A11>, <0xC6604A11>, <0xC6608A11>,
				    <0x20041911>, <0x20045911>, <0x20049911>,
				    <0x94aa2011>, <0x94aa6011>, <0x94aaa011>,
				    <0x17171511>, <0x17175511>, <0x17179511>,
				    <0x07701611>, <0x07705611>, <0x07709611>,
				    <0x00002a11>, <0x00006a11>, <0x0000aa11>,
				    <0x27710311>, <0x27684311>, <0x27648311>,
				    <0x29001011>, <0x29005011>, <0x29009011>,
				    <0xc0000C11>, <0xc0004C11>, <0xc0008C11>,
				    <0x00271711>, <0x00275711>, <0x00279711>;

			tx-driving-tbl = <0x94a72011>, <0x94a76011>, <0x94a7a011>,
					  <0x587a2111>, <0x587a6111>, <0x587aa111>;

			rx-sense-tbl = <0x72100911>, <0x72104911>, <0x72108911>,
					<0x27750311>, <0x276e4311>, <0x276c8311>;
		};
	};

	sata@3f000 {
		compatible = "realtek,rtd1296-ahci";
		reg = <0x3f000 0xf00>;
		interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		sata-port@0 {
			reg = <0>;
			phys = <&sata_phy 0>;
			phy-names = "sata-phy";
		};

		sata-port@1 {
			reg = <1>;
			phys = <&sata_phy 1>;
			phy-names = "sata-phy";
		};
	};

	/*
	 * GMAC. Same hardware/driver as Monarch (r8169soc, "Realtek,r8168"),
	 * confirmed by the real boot log: "r8169 98016000.gmac eth0:
	 * RTL8169SOC".
	 */
	/*
	 * USB. Same three dwc3 blocks as Monarch (drd/u2host/u3host all
	 * physically present on RTD1295 already; RTD1296 additionally hangs
	 * an RTS5400 Type-C PD companion chip off the u3host port via i2c5 --
	 * investigated and closed, see README.md's Progress log; its
	 * hub function needs no driver, u3host already confirmed working as
	 * a plain host). No board-specific PHY calibration tables here, same
	 * as Monarch -- the mainline phy-rtk-usb2/usb3 driver defaults
	 * (shared with Monarch, not board-specific) are confirmed sufficient
	 * on real Duo hardware too: xhci-hcd.2.auto (io mem 0x981f0000, the
	 * u3host controller) negotiated a real USB 3.0 SuperSpeed link with
	 * a device on its SS root hub (bus 5), no link-training errors in
	 * dmesg. Vendor rtd-1296-pelican-1GB.dts's dwc3_u3host_usb3phy/
	 * usb2phy tables were never needed. See README.md's Progress
	 * log for the full story.
	 */
	usb2phy_u2: usb-phy@13c14 {
		compatible = "realtek,rtd1295-usb2phy";
		reg = <0x13c14 0x4>, <0x31280 0x4>;
		#phy-cells = <0>;
	};

	usb2phy_u3: usb-phy@13e14 {
		compatible = "realtek,rtd1295-usb2phy";
		reg = <0x13e14 0x4>, <0x1f8280 0x4>;
		#phy-cells = <0>;
	};

	usb3phy_u3: usb-phy@13e10 {
		compatible = "realtek,rtd1295-usb3phy";
		reg = <0x13e10 0x4>;
		#phy-cells = <0>;
	};

	soc_thermal: thermal-sensor@1d150 {
		compatible = "realtek,rtd129x-thermal-sensor";
		reg = <0x1d150 0x20>;
		#thermal-sensor-cells = <0>;
	};

	usb2phy_drd: usb-phy@13214 {
		compatible = "realtek,rtd1295-usb2phy";
		reg = <0x13214 0x4>, <0x28280 0x4>;
		#phy-cells = <0>;
	};

	usb3phy_drd: usb-phy@13210 {
		compatible = "realtek,rtd1295-usb3phy";
		reg = <0x13210 0x4>;
		#phy-cells = <0>;
	};

	usb_wrap_drd: usb@13200 {
		compatible = "realtek,rtd1295-dwc3", "realtek,rtd-dwc3";
		reg = <0x13200 0x200>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		usb_drd: usb@20000 {
			compatible = "snps,dwc3";
			reg = <0x20000 0x9000>;
			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb2phy_drd>, <&usb3phy_drd>;
			phy-names = "usb2-phy", "usb3-phy";
			dr_mode = "host";
			snps,dis_u2_susphy_quirk;
			snps,dis_ss_park_mode;
			resets = <&reset1 RTD1295_RSTN_USB>,
				 <&reset1 RTD1295_RSTN_USB_PHY0>,
				 <&reset1 RTD1295_RSTN_USB3_PHY0_POW>,
				 <&reset1 RTD1295_RSTN_USB3_P0_MDIO>;
		};
	};

	usb_wrap_u2host: usb@13c00 {
		compatible = "realtek,rtd1295-dwc3", "realtek,rtd-dwc3";
		reg = <0x13c00 0x200>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		usb_u2host: usb@29000 {
			compatible = "snps,dwc3";
			reg = <0x29000 0x9000>;
			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb2phy_u2>;
			phy-names = "usb2-phy";
			dr_mode = "host";
			snps,dis_u2_susphy_quirk;
			resets = <&reset1 RTD1295_RSTN_USB>,
				 <&reset1 RTD1295_RSTN_USB_PHY0>,
				 <&reset1 RTD1295_RSTN_USB_PHY1>,
				 <&reset2 RTD1295_RSTN_USB_PHY2>,
				 <&reset2 RTD1295_RSTN_USB_PHY3>;
		};
	};

	usb_wrap_u3host: usb@13e00 {
		compatible = "realtek,rtd1295-dwc3", "realtek,rtd-dwc3";
		reg = <0x13e00 0x200>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		usb_u3host: usb@1f0000 {
			compatible = "snps,dwc3";
			reg = <0x1f0000 0x9000>;
			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			phys = <&usb2phy_u3>, <&usb3phy_u3>;
			phy-names = "usb2-phy", "usb3-phy";
			dr_mode = "host";
			snps,dis_u2_susphy_quirk;
			snps,dis_ss_park_mode;
			resets = <&reset1 RTD1295_RSTN_USB>,
				 <&reset1 RTD1295_RSTN_USB3_PHY0_POW>,
				 <&reset1 RTD1295_RSTN_USB3_P0_MDIO>,
				 <&reset2 4>,
				 <&reset2 RTD1295_RSTN_USB3_P1_MDIO>;
		};
	};

	gmac: ethernet@16000 {
		compatible = "Realtek,r8168";
		reg = <0x16000 0x1000>, <0x7000 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
		resets = <&iso_reset RTD1295_ISO_RSTN_GMAC>,
			 <&iso_reset RTD1295_ISO_RSTN_GPHY>;
		reset-names = "gmac", "gphy";
		output-mode = <0>;
		mac-version = <0x2a>;
		ext-phy-id = <1>;
		led-cfg = <0x804f>;
		rtl-config = <1>;
		rtl-features = <2>;
		eee = <1>;
		rgmii-voltage = <1>;
		rgmii-tx-delay = <0>;
		rgmii-rx-delay = <0>;
		status = "okay";
	};

	/*
	 * SPI-NOR flash controller (SFC) and the flash-backed RTC that rides
	 * on it (Monarch's drivers/rtc/rtc-wd-mch-flash.c) are NOT enabled
	 * here -- investigated and closed, not just deferred. Unlike
	 * Monarch's SFC (which came back a real, if initially misread,
	 * Winbond ID), this Duo unit's SFC probe fails outright with
	 * "unrecognized JEDEC id bytes: ff, ff, ff" (all-high SPI lines, the
	 * classic "nothing answering" pattern, not a protocol/misdetection
	 * error).
	 *
	 * The open question was whether that's a rescue-DT power/mux gap or
	 * a genuinely absent chip. Resolved by checking two things: (1) the
	 * vendor's own *production* board DTS (rtd-1296-pelican-1GB.dts)
	 * doesn't override the SFC node at all -- it inherits
	 * `status = "okay"` from the shared rtd-1296.dtsi exactly like the
	 * rescue board DTS (rtd-1296-pelican-rescue.dts) does, with zero
	 * board-level pin/power difference between the two; (2) a captured
	 * boot log of the *vendor's own* 4.9.330 kernel and rtk-sfc driver,
	 * on this same real unit, shows the identical
	 * "unrecognized JEDEC id bytes: ff, ff, ff" failure. Vendor
	 * software, vendor driver, identical DT config to production --
	 * still nothing answers. That rules out a rescue-specific gap; this
	 * unit's boot SPI-NOR is most likely simply not populated (a BOM
	 * variant) or non-functional on this specific board, not something
	 * a DT/driver change on our side can fix. System clock defaults to
	 * the epoch and gets fixed by NTP once the network is up, same as
	 * Monarch before its flash-RTC was added -- and the same fallback
	 * this Duo unit needs permanently, not just until porting catches
	 * up.
	 */
	sfc: sfc@1a800 {
		compatible = "realtek,rtk-sfc";
		reg = <0x1a800 0x50>;
		status = "disabled";
	};

	/*
	 * eMMC (drivers/mmc/host/dw_mmc-rtd129x.c). The vendor's original
	 * design boots the OS from here and uses the two SATA bays for RAID
	 * data only; this port instead runs rootfs from SATA (see the file
	 * header comment) and treats the eMMC as a plain, mountable block
	 * device. Phase 1: MMC_TIMING_MMC_HS (~50MHz), fixed phase, no
	 * tuning -- matches this exact board's own production DTS
	 * (rtd-1296-pelican-1GB.dts: `speed-step = <0>;` i.e. SDR,
	 * `phase_tuning = <0 0>;` i.e. tuning disabled). `pad-driving` below
	 * is that DTS's `pddrive_nf_s0` verbatim (clk/cmd/data/ds = 0x77/
	 * 0x77/0x77/0x33). HS200/HS400 not wired up -- see dw_mmc-rtd129x.c.
	 */
	emmc: mmc@12000 {
		compatible = "realtek,rtd1295-dw-mshc";
		reg = <0x12000 0xa00>;
		interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <100000000>;
		/*
		 * The mainline dw_mmc core's own fallback -- reading
		 * FIFOTH's power-on RX_WMark value back at probe time to
		 * infer fifo_depth -- doesn't work on this board: the
		 * bootloader already reprograms FIFOTH (to 0x0001007f)
		 * while loading the kernel Image off this exact eMMC
		 * controller earlier in the same boot, long before Linux
		 * gets a chance to read the untouched value. Observed on
		 * real hardware: "2 deep fifo" (from a corrupted RX_WMark=1
		 * readback), followed by a full kernel hang/RCU stall
		 * shortly after mmc0 registers -- consistent with a FIFO
		 * threshold/DMA-burst-size mismatch against the real
		 * hardware FIFO. The vendor rtkemmc.c source carries the
		 * true power-on value in a comment right next to its own
		 * FIFOTH override: `// original: 0x0007f007f`, i.e.
		 * RX_WMark=0x7f=127 -- matching the mainline comment's
		 * "power-on value of RX_WMark is FIFO_DEPTH-1" exactly, so
		 * FIFO_DEPTH=128. Supplying it explicitly skips the broken
		 * readback path entirely.
		 */
		fifo-depth = <128>;
		bus-width = <8>;
		non-removable;
		cap-mmc-highspeed;
		realtek,pad-driving = <1 0x77 0x77 0x77 0x33>;
		/* HS200 (Phase 2) pad-driving table -- vendor's pddrive_nf_s2
		 * default from rtd-1296.dtsi (stronger clk/cmd/data drive
		 * than SDR/HS, ds unchanged). Same fallback is built into
		 * dw_mmc-rtd129x.c if this property is absent.
		 */
		realtek,pad-driving-hs200 = <1 0xbb 0xbb 0xbb 0x33>;
		status = "okay";
	};
};

&uart0 {
	interrupt-parent = <&mux_intc>;
	interrupts = <1 2>;
	interrupts-st-mask = <0x4>;
	status = "okay";
};

&uart1 {
	status = "disabled";
};

&uart2 {
	status = "disabled";
};

/* SMP spin-table, identical mechanism to Monarch -- same SoC family. */
&cpu0 {
	enable-method = "spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

&cpu1 {
	enable-method = "spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

&cpu2 {
	enable-method = "spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

&cpu3 {
	enable-method = "spin-table";
	cpu-release-addr = <0x0 0x9801aa44>;
};

/* eMMC (98012000.emmc on this SoC family) -- ported and confirmed
 * working on real hardware (`drivers/mmc/host/dw_mmc-rtd129x.c`, PIO
 * mode, HS200 Phase 2 also confirmed -- see the `emmc` node further
 * down and README.md's Progress log for the full story).
 * Rootfs still runs from the two SATA bays, not eMMC -- same choice
 * Monarch's mainline port already made over the vendor's original
 * eMMC-boot/SATA-data scheme; eMMC is just a plain mountable block
 * device here, not a boot path.
 */

/* RTS5400 Type-C PD companion chip on i2c5 (vendor rtd1296.dtsi &i2c_5
 * node) -- investigated and closed, not planned. Its USB3 hub function
 * is transparent hardware (u3host already confirmed working as a plain
 * host); the vendor I2C driver only gates one optional 12V
 * accessory-power GPIO after a proprietary, non-mainline-compatible PD
 * protocol. See README.md's Progress log for the full reasoning.
 */

/*
 * Fan trip points (fan-alert0/1) are this port's own choice, not a vendor
 * value carried over: the vendor's rtk_fan.c has no in-kernel thermal
 * curve at all -- just a manual 0-10 sysfs knob plus tach RPM readback,
 * presumably driven by a userspace daemon this port doesn't have source
 * for. 55C/70C give the fan a chance to cool the board (two spinning SATA
 * drives share this enclosure) well before soc_hot's 85C passive
 * CPU-throttle point would ever need to engage. Unlike every other
 * threshold in this file, these two are not cross-checked against
 * anything -- reasonable first guesses, worth revisiting once real
 * hardware shows actual temperatures under load.
 */
/ {
	thermal-zones {
		soc-thermal {
			polling-delay-passive = <250>;
			polling-delay = <10000>;
			thermal-sensors = <&soc_thermal>;

			trips {
				fan_alert0: fan-alert0 {
					temperature = <55000>;
					hysteresis = <5000>;
					type = "active";
				};

				fan_alert1: fan-alert1 {
					temperature = <70000>;
					hysteresis = <5000>;
					type = "active";
				};

				soc_hot: soc-hot {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};

				soc-crit {
					temperature = <105000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&soc_hot>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&fan_alert0>;
					cooling-device = <&fan0 1 1>;
				};

				map2 {
					trip = <&fan_alert1>;
					cooling-device = <&fan0 2 2>;
				};
			};
		};
	};
};

&iso {
	pwm: pwm@d0 {
		compatible = "realtek,rtd129x-pwm";
		reg = <0xd0 0xc>;
		clocks = <&osc27M>;
		#pwm-cells = <2>;
	};
};

&hwrtc {
	/*
	 * Unlike Monarch's board (confirmed no battery on real hardware,
	 * left unbound there), this Duo unit has a physically-confirmed
	 * coin-cell battery on the board. The flash-backed RTC scheme
	 * (Monarch's drivers/rtc/rtc-wd-mch-flash.c) isn't an option here
	 * anyway -- this unit's boot SPI-NOR doesn't respond (see the SFC
	 * node comment above) -- so this real hardware counter
	 * (drivers/rtc/rtc-rtd119x.c) is the only candidate. Whether the
	 * battery is actually wired to this specific block's VBAT/always-on
	 * rail (as opposed to powering something else on the board) is what
	 * enabling it and checking RTCACR.RTCPWR / testing persistence
	 * across a real power cycle will tell us -- see rtd129x.dtsi's rtc0
	 * node comment for how the driver self-detects a cold start vs. a
	 * genuinely retained one.
	 */
	status = "okay";
};

/*
 * LEDs and fan, PWM channel assignment confirmed against the real boot
 * log: "[RTK_PWM] rtd1295_pwm_probe - hwpwm=(3) enable=(1) duty_rate=(20)
 * clksrc_div=(1) clkout_div=(255) ... default output frequence =
 * 26367Hz" -- channel 3 is the fan at 20% duty, not the SYS LED (which is
 * channel 0 on this board, unlike Monarch where it's channel 3). Same
 * clksrc_div/clkout_div (and hence the same ~26367 Hz / 37926 ns period)
 * as Monarch -- shared per-block clock divider, only per-channel duty
 * differs. The 10% SYS LED duty (channel 0) comes from the vendor
 * production board DTS (rtd-1296-pelican-1GB.dts pwm_0), not directly
 * from this log (which only shows the fan channel's probe line).
 */
/ {
	leds {
		compatible = "pwm-leds";

		led-sys {
			label = "white:sys";
			pwms = <&pwm 0 37926>;
			max-brightness = <255>;
			default-state = "on";
			default-brightness = <26>;
		};
	};

	/*
	 * Confirmed on real hardware: manual pwm1 writes (0/128/255) via the
	 * generic mainline pwm-fan driver correctly vary the physical fan
	 * speed (see README.md's Confirmed working list). Now wired
	 * into soc-thermal's cooling-maps (fan-alert0/1, see the comment
	 * above that thermal-zones block) so the three cooling-levels below
	 * (off/~20%/~50%) get driven automatically instead of staying at a
	 * fixed duty -- not yet hardware-tested. RPM feedback comes from
	 * the separate fan_tach node below (drivers/hwmon/rtd129x-fan-tach.c).
	 */
	fan0: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm 3 37926>;
		cooling-min-state = <0>;
		cooling-max-state = <2>;
		#cooling-cells = <2>;
		cooling-levels = <0 51 128>;
	};

	/*
	 * Reset button. Unlike symops/MCG1-6.18's board (LS1024A, GPIO_2,
	 * cross-confirmed against two separate vendor sources -- both
	 * barebox's commands/wd_button.c and the vendor kernel's
	 * drivers/input/misc/btn-wd.c read the exact same bit), the RTD1296
	 * vendor 4.9.330 tree has no dedicated button driver of its own at
	 * all -- confirmed by grepping drivers/input/misc/ for anything
	 * WD-specific there. The only trace of this button anywhere in the
	 * GPL source drop is the generic "Realtek,power-management"
	 * wakeup-gpio-list node in the vendor's rtd-1296-pelican-1GB.dts,
	 * which turned out to be the WRONG lead: it lists two candidate
	 * wakeup GPIOs on &rtk_iso_gpio (14 disabled, 22 enabled), and 22
	 * -- the only enabled one, the seemingly obvious guess -- does
	 * NOT move on a real button press (confirmed on real hardware with
	 * this node wired to it: gpio-keys registered fine, but evtest
	 * showed zero events, and /sys/kernel/debug/gpio confirmed the line
	 * genuinely never changes state while holding the button).
	 *
	 * Found the real line empirically instead, with no kernel rebuild
	 * needed: `gpioget -c gpiochip0 0 1 2 ... 34` (skipping 22, held
	 * busy by this very node) run once unpressed and once with the
	 * button held, diffing the two 34-value dumps. Exactly one line
	 * changed, active -> inactive, between the two reads: **GPIO 20**.
	 * Everything else (all 33 other lines) read identically both times
	 * -- about as clean a positive identification as this kind of
	 * black-box probing gets. GPIO 14, the vendor's other, disabled
	 * wakeup-gpio-list candidate, was never actually tested since 20
	 * already gave an unambiguous answer.
	 *
	 * Real IRQ, not polling: unlike LS1024A (no GPIO irqchip anywhere,
	 * vendor or mainline, forcing MCG1 to gpio-keys-polled), this SoC's
	 * &mux_intc + drivers/gpio/gpio-rtd.c combination is already proven
	 * on real Duo hardware for i2c0-i2c5 above, so a plain interrupt-
	 * driven "gpio-keys" node works here with no driver changes needed.
	 * (The gpiochip_enable_irq() WARN seen with the wrong-GPIO version
	 * of this node was a red herring, not a real bug: real hardware
	 * confirmed via /sys/kernel/debug/gpio that direction was correctly
	 * "in" the whole time -- the actual problem was always the GPIO
	 * number, not the IRQ plumbing.)
	 *
	 * KEY_PROG1 rather than KEY_RESTART, same reasoning and same real-
	 * hardware finding as MCG1's button node: KEY_RESTART gets treated
	 * as a genuine reboot request by systemd-logind on its own, with
	 * nothing of ours asking for that.
	 */
	gpio_keys: gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "Reset";
			linux,code = <KEY_PROG1>;
			gpios = <&rtk_iso_gpio 20 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * Fan tachometer (RPM readback) -- a separate, self-contained IP block
 * from the PWM controller above, confirmed register-for-register against
 * the vendor 4.9.330 tree's rtk_fan.c ("realtek,rtk-fan") and this
 * board's own rtd-1296-pelican-1GB.dts override (same pwms = <&pwm 3 ...>
 * channel as fan0 above, status = "okay"). Not yet hardware-tested.
 * Placed under &misc (like &hwrtc) rather than the shared rtd129x.dtsi:
 * mux_intc, which this needs for its interrupt, is itself declared per-
 * board in this project (see mux_intc: interrupt-controller@1b000 above),
 * not in the shared dtsi, so board-level is where every other mux_intc
 * consumer already lives too.
 */
&misc {
	fan_tach: fan-tach@c00 {
		compatible = "realtek,rtd1295-fan-tach";
		reg = <0xc00 0x14>;
		interrupt-parent = <&mux_intc>;
		interrupts = <0 29>;
		resets = <&reset4 RTD1295_RSTN_FAN>;

		timer_target = <0x100000>;
		fan_debounce = <0x0>;
		fan_factor = <2>;
	};
};

&crt {
	scpu_clk: clock-controller {
		compatible = "realtek,rtd129x-scpu-clk";
		clocks = <&osc27M>;
		#clock-cells = <0>;
	};
};

&cpu0 {
	clocks = <&scpu_clk>;
	#cooling-cells = <2>;
	operating-points-v2 = <&cpu_opps>;
};

&cpu1 {
	clocks = <&scpu_clk>;
	#cooling-cells = <2>;
	operating-points-v2 = <&cpu_opps>;
};

&cpu2 {
	clocks = <&scpu_clk>;
	#cooling-cells = <2>;
	operating-points-v2 = <&cpu_opps>;
};

&cpu3 {
	clocks = <&scpu_clk>;
	#cooling-cells = <2>;
	operating-points-v2 = <&cpu_opps>;
};

/*
 * Same divider-only cpufreq scheme as Monarch. Confirmed on real Duo
 * hardware: the boot loader actually leaves PLL_SCPU decoding to
 * 600000 kHz (1200 MHz PLL / div2 -- not exactly the 1201.5 MHz
 * Monarch's comment describes, but the same table entry), which
 * cpufreq_policy_online logs as an "unlisted initial frequency" and
 * snaps to the nearest OPP (600750 kHz) at boot -- a normal, harmless
 * cpufreq-core step, not a bug. schedutil subsequently drove a real
 * scale-up to the top OPP (1100000 kHz), the code path that both
 * reprograms the PLL NF register *and* changes the post-divider
 * (2 -> 1, anti-glitch ordered): confirmed via cpuinfo_cur_freq
 * reading back 1100000 straight from hardware after the transition,
 * with the board still responsive. Full OPP range exercised, no hang.
 */
/ {
	cpu_opps: opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-300375000 {
			opp-hz = /bits/ 64 <300375000>;
			clock-latency-ns = <150000>;
		};

		opp-600750000 {
			opp-hz = /bits/ 64 <600750000>;
			clock-latency-ns = <150000>;
			opp-suspend;
		};

		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			clock-latency-ns = <300000>;
		};
	};
};
